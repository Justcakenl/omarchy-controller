#!/bin/bash
# Toggle the wvkbd on-screen keyboard, themed like the current Omarchy theme.
#   osk-toggle            show/hide (starts it if needed)
#   osk-toggle --restyle  re-launch with the current theme colors, keeping shown/hidden
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STATE="${XDG_RUNTIME_DIR:-/tmp}/controller-desktop/osk"
mkdir -p "$(dirname "$STATE")"

start() { # $1 = --hidden or empty
  mapfile -t colors < <(/usr/bin/python3 "$HERE/osk-colors.py")
  setsid -f wvkbd-mobintl -L 320 "${colors[@]}" $1 >/dev/null 2>&1
}

running() { pgrep -x wvkbd-mobintl >/dev/null; }

case "$1" in
  --restyle)
    running || exit 0
    hidden=""; [[ "$(cat "$STATE" 2>/dev/null)" == hidden ]] && hidden="--hidden"
    pkill -x wvkbd-mobintl; sleep 0.2
    start "$hidden"
    ;;
  *)
    if running; then
      pkill -RTMIN -x wvkbd-mobintl
      [[ "$(cat "$STATE" 2>/dev/null)" == hidden ]] && echo shown > "$STATE" || echo hidden > "$STATE"
    else
      echo shown > "$STATE"
      start ""
    fi
    ;;
esac
